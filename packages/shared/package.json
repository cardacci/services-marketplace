{
	"name": "@sm/shared",
	"version": "0.0.0",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsup src/index.ts --format cjs,esm --dts",
		"dev": "tsup src/index.ts --format cjs,esm --dts --watch",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"tsup": "^9.0.0",
		"typescript": "~6.0.3"
	}
}
